{
  "expo": {
    "name": "Cortex",
    "slug": "cortex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bigclawai.cortex",
      "infoPlist": {
        "NSCameraUsageDescription": "Cortex needs camera access to capture screenshots and photos for your knowledge hub.",
        "NSPhotoLibraryUsageDescription": "Cortex needs photo library access to import images into your knowledge hub."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.bigclawai.cortex",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "cortex",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Cortex needs photo library access to import images."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 5
          },
          "iosShareExtensionName": "Cortex Share",
          "androidIntentFilters": ["image/*"],
          "androidMultiIntentFilters": ["image/*"]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Cortex needs access to your photo library to import and organize images.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
